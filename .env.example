# Server
APP_NAME=FMS Backend
APP_ENV=development
APP_PORT=3100
APP_DEBUG=true
APP_DATA_DIR=data

# Database (sama dengan demo fmctest; dipakai Prisma + Go)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/db_fmc150?sslmode=disable
DB_TIMEZONE=Asia/Jakarta

# Port TCP alat FMC150 (Teltonika).
DEVICE_PORT=3101
# Tunnel publik buat alat lewat 4G waktu development: true = buka ngrok (kalau gagal bore.pub),
# false = nggak ada tunnel sama sekali (udah deploy: alat konek langsung ke IP/domain VPS:DEVICE_PORT).
TUNNEL=false
NGROK_AUTHTOKEN=
BORE_HOST=bore.pub
# Alamat publik tetap (mis. domain VPS + DEVICE_PORT): ditampilin di dashboard buat SMS setting alat.
# Kalau diisi, tunnel nggak dibuka.
TUNNEL_HOST=
TUNNEL_PORT=

# JWT (access pendek, refresh panjang + rotate)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRED_HOUR=1
JWT_REFRESH_EXPIRED_HOUR=168

# CORS: fms-supervisor (3000) + fms-administrator (3001)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Routing & geocode (OpenStreetMap)
ROUTING=1
OSRM_URL=https://router.project-osrm.org
TRUCK_FACTOR=1.3
OVERPASS_URL=
GEOCODE=1
TZ_REPORT=Asia/Jakarta

# Seeder (go run main.go -seed): 1 user per role, password sama semua:
#   admin@fms.id (ADMIN), owner@fms.id (OWNER), supervisor@fms.id (SUPERVISOR), viewer@fms.id (VIEWER)
SEED_PASSWORD=change-me-123
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Administrator

LOG_FORMAT=console
