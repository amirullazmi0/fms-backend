// Skema database FMS (Prisma hanya dipakai untuk migrasi; backend Go melakukan query langsung melalui lib/pq).
// Asal: fmctest/prisma/schema.prisma, ditambah konvensi kratify:
//   - users: refresh token, is_active, soft delete + audit
//   - tabel master (devices, sites, routes, drivers, shift_templates, shifts): deleted_at + created_by/updated_by/deleted_by
//   - role & permission (pola presiden-solusi): roles, permissions, role_permissions, users.role_id
// Tabel log/time-series (records, events, commands, places, assignments, trips) tidak memakai soft delete.

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum UserType {
  staff
  operator

  @@map("user_type")
}

/// staff = login dashboard (email + password). operator = driver / operator alat, login MDT (NIK + PIN),
/// tidak memiliki email / password. Check users_staff_login & index unik NIK operator ada di migrasi.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?   @unique
  name            String?
  passwordHash    String?   @map("password_hash") // bcrypt (hash scrypt lama dari demo masih dikenali, diganti bcrypt saat login)
  userType        UserType  @default(staff) @map("user_type")
  employeeNo      String?   @map("employee_no") // NIK (operator)
  phone           String?
  ibutton         String?
  /// PIN login MDT (bcrypt), operator saja.
  pinHash         String?   @map("pin_hash")
  note            String?
  roleId          String    @map("role_id") @db.Uuid
  /// Superuser: lolos semua cek role & permission, boleh masuk fms-administrator.
  isAdministrator Boolean   @default(false) @map("is_administrator")
  isActive        Boolean   @default(true) @map("is_active")
  refreshToken    String?   @map("refresh_token") // sha256 dari refresh token aktif
  tokenExpiry     DateTime? @map("token_expiry") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedBy       String?   @map("deleted_by") @db.Uuid
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions        Session[]
  shiftsCreated   Shift[]   @relation("ShiftCreatedBy")
  shiftsClosed    Shift[]   @relation("ShiftClosedBy")
  // sebagai operator
  assignments     Assignment[]
  trips           Trip[]
  siteVisits      SiteVisit[]
  unitStatusLogs  UnitStatusLog[]

  @@index([roleId], map: "idx_user_role")
  @@index([userType], map: "users_user_type")
  @@map("users")
}

/// Role yang bisa diatur dari dashboard. Satu role boleh is_default (dipakai bila user dibuat tanpa role);
/// index unik parsial idx_roles_single_default ada di migrasi (Prisma tidak dapat menulis index parsial).
model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(100)
  isDefault       Boolean          @default(false) @map("is_default")
  /// Boleh masuk aplikasi fms-administrator (atur role, permission, user).
  isAdministrator Boolean          @default(false) @map("is_administrator")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  deletedBy       String?          @map("deleted_by") @db.Uuid
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Katalog permission. Nama = konstanta di internal/model/permission.go; diisi lewat migrasi.
model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  deletedBy    String?    @map("deleted_by") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@index([roleId, permissionId], map: "idx_role_permission")
  @@map("role_permissions")
}

/// Deprecated: session cookie demo lama. Auth sekarang JWT access + refresh token (users.refresh_token).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique(map: "sessions_token_hash_key") @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  ip        String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "sessions_user_id")
  @@map("sessions")
}

// ---------- Tracking ----------

/// Jenis unit: DT (dump truck), EX (excavator), LV (light vehicle), SUPPORT (grader, dozer, water/fuel truck).
enum UnitType {
  DT
  EX
  LV
  SUPPORT

  @@map("unit_type")
}

/// Satu baris per alat, primary key IMEI. Alat baru otomatis ditambahkan saat pertama kali terhubung.
model Device {
  imei            String       @id
  name            String?
  plate           String?
  vehicle         String?
  firstSeen       DateTime     @map("first_seen") @db.Timestamptz(3)
  lastSeen        DateTime?    @map("last_seen") @db.Timestamptz(3)
  lastConnectedAt DateTime?    @map("last_connected_at") @db.Timestamptz(3)
  lastRemote      String?      @map("last_remote")
  /// Muatan per rit (truck factor, ton). Tonase = ritase × payload_ton.
  payloadTon      Float        @default(20) @map("payload_ton")
  unitType        UnitType     @default(DT) @map("unit_type")
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid
  deletedBy       String?      @map("deleted_by") @db.Uuid
  records         Record[]
  events          Event[]
  commands        Command[]
  assignments     Assignment[]
  trips           Trip[]

  siteVisits     SiteVisit[]
  unitStatusLogs UnitStatusLog[]
  mdtTablets     MdtTablet[]

  @@map("devices")
}

/// Record AVL dari alat: posisi + semua IO (JSONB, key = AVL ID).
model Record {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imei       String
  time       DateTime @db.Timestamptz(3)
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  lat        Float
  lng        Float
  alt        Int
  angle      Int
  sats       Int
  speed      Int
  priority   Int
  eventIo    Int      @map("event_io")
  valid      Boolean
  io         Json
  device     Device   @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@unique([imei, time, eventIo, priority], map: "records_unique")
  @@index([imei, time], map: "records_imei_time")
  @@map("records")
}

/// Event hasil deteksi (ignition, overspeed, BBM, koneksi, ...).
model Event {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imei   String
  time   DateTime @db.Timestamptz(3)
  level  String // info | warn | crit
  kind   String
  text   String
  device Device   @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([time], map: "events_time")
  @@map("events")
}

/// Perintah GPRS (Codec 12) ke alat dan balasannya.
model Command {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imei   String
  time   DateTime @db.Timestamptz(3)
  dir    String // out = ke alat, in = balasan alat
  text   String
  device Device   @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([imei, time], map: "commands_imei_time")
  @@map("commands")
}

/// Cache nama jalan dari OpenStreetMap (key = "lat,lng" dibulatkan 4 desimal).
model Place {
  key       String   @id
  label     String?
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@map("places")
}

// Master titik (geofence). Peran front loading / dumping ditentukan di rute; satu titik bisa dipakai banyak rute.
model Site {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  lat              Float
  lng              Float
  radiusM          Int       @default(10) @map("radius_m")
  /// Alert antrean: >= queueAlertTrucks unit antre lebih dari queueAlertMin menit.
  queueAlertTrucks Int       @default(3) @map("queue_alert_trucks")
  queueAlertMin    Int       @default(15) @map("queue_alert_min")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedBy        String?   @map("deleted_by") @db.Uuid
  loadingRoutes    Route[]   @relation("RouteLoading")
  unloadingRoutes  Route[]   @relation("RouteUnloading")

  siteVisits SiteVisit[]
  zones      SiteZone[]

  @@map("sites")
}

// Rute = 1 front loading + 1 dumping. Operator & unit masuk melalui penugasan shift.
model Route {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  loadingSiteId   String       @map("loading_site_id") @db.Uuid
  unloadingSiteId String       @map("unloading_site_id") @db.Uuid
  note            String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid
  deletedBy       String?      @map("deleted_by") @db.Uuid
  loadingSite     Site         @relation("RouteLoading", fields: [loadingSiteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unloadingSite   Site         @relation("RouteUnloading", fields: [unloadingSiteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignments     Assignment[]
  shifts          Shift[]
  trips           Trip[]

  siteVisits SiteVisit[]
  targets    ProductionTarget[]

  @@index([loadingSiteId], map: "routes_loading_site_id")
  @@index([unloadingSiteId], map: "routes_unloading_site_id")
  @@map("routes")
}

enum ShiftStatus {
  planned
  active
  closed

  @@map("shift_status")
}

enum ShiftCloseReason {
  manual
  auto

  @@map("shift_close_reason")
}

enum TripStatus {
  done
  unfinished

  @@map("trip_status")
}

// go = hauling (front loading → dumping), back = return (dumping → front loading)
enum TripLeg {
  go
  back

  @@map("trip_leg")
}


model ShiftTemplate {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  startTime DateTime  @map("start_time") @db.Time(0)
  endTime   DateTime  @map("end_time") @db.Time(0)
  autoClose Boolean   @default(true) @map("auto_close")
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("shift_templates")
}

model Shift {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  routeId      String?           @map("route_id") @db.Uuid // 1 shift = 1 rute
  date         DateTime          @db.Date
  plannedStart DateTime          @map("planned_start") @db.Timestamptz(3)
  plannedEnd   DateTime          @map("planned_end") @db.Timestamptz(3)
  autoClose    Boolean           @default(true) @map("auto_close")
  status       ShiftStatus       @default(planned)
  startedAt    DateTime?         @map("started_at") @db.Timestamptz(3)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  closeReason  ShiftCloseReason? @map("close_reason")
  overdueNoted Boolean           @default(false) @map("overdue_noted")
  createdById  String?           @map("created_by") @db.Uuid
  closedById   String?           @map("closed_by") @db.Uuid
  note         String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)
  updatedBy    String?           @map("updated_by") @db.Uuid
  deletedBy    String?           @map("deleted_by") @db.Uuid
  createdBy    User?             @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  closedBy     User?             @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  route        Route?            @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignments  Assignment[]
  trips        Trip[]

  siteVisits SiteVisit[]

  @@index([date], map: "shifts_date")
  @@index([routeId], map: "shifts_route_id")
  @@index([status], map: "shifts_status")
  @@map("shifts")
}

// Penugasan satu shift: operator membawa unit di rute tertentu, berlaku start_at..end_at.
// Pindah rute / ganti unit di tengah shift = penugasan lama ditutup, yang baru dibuka.
model Assignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId   String    @map("shift_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  imei      String
  routeId   String    @map("route_id") @db.Uuid
  note      String?
  startAt   DateTime? @map("start_at") @db.Timestamptz(3) // null = dari awal shift
  endAt     DateTime? @map("end_at") @db.Timestamptz(3) // null = masih berlaku
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  driver    User      @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  device    Device    @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  trips     Trip[]

  siteVisits     SiteVisit[]
  unitStatusLogs UnitStatusLog[]

  @@index([shiftId], map: "assignments_shift_id")
  @@map("assignments")
}

// Ritase tersimpan (dasar laporan). Nama rute & titik disalin agar laporan lama tidak berubah.
model Trip {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId    String?     @map("assignment_id") @db.Uuid
  shiftId         String?     @map("shift_id") @db.Uuid
  driverId        String?     @map("driver_id") @db.Uuid
  imei            String
  routeId         String?     @map("route_id") @db.Uuid
  routeName       String      @map("route_name")
  loadingSiteId   String?     @map("loading_site_id") @db.Uuid
  loadingName     String      @map("loading_name")
  unloadingSiteId String?     @map("unloading_site_id") @db.Uuid
  unloadingName   String      @map("unloading_name")
  departAt        DateTime    @map("depart_at") @db.Timestamptz(3)
  arriveAt        DateTime?   @map("arrive_at") @db.Timestamptz(3)
  durationMs      BigInt      @map("duration_ms")
  distanceM       Float       @map("distance_m")
  movingMs        BigInt      @map("moving_ms")
  stops           Int
  stoppedMs       BigInt      @map("stopped_ms")
  maxSpeed        Int         @map("max_speed")
  avgSpeed        Float       @map("avg_speed")
  fuelUnit        String?     @map("fuel_unit")
  fuelAtLoading   Float?      @map("fuel_at_loading")
  fuelAtUnloading Float?      @map("fuel_at_unloading")
  fuelUsed        Float?      @map("fuel_used")
  loadDwellMs     BigInt      @map("load_dwell_ms")
  unloadDwellMs   BigInt?     @map("unload_dwell_ms")
  /// Snapshot devices.payload_ton saat dihitung.
  payloadTon      Float?      @map("payload_ton")
  status          TripStatus
  leg             TripLeg     @default(go)
  computedAt      DateTime    @default(now()) @map("computed_at") @db.Timestamptz(3)
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  shift           Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  driver          User?       @relation(fields: [driverId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  device          Device      @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)
  route           Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([imei, departAt], map: "trips_imei_depart")
  @@index([departAt], map: "trips_depart_at")
  @@index([shiftId], map: "trips_shift_id")
  @@map("trips")
}

// ---------- Fitur ----------

/// Fitur & konfigurasi yang diatur dari fms-administrator (mis. "simulation").
model Feature {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  description String?
  enabled     Boolean   @default(false)
  config      Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid

  @@map("features")
}

// ---------- Waktu di titik ----------

enum SiteVisitRole {
  loading
  unloading

  @@map("site_visit_role")
}

enum SiteVisitStatus {
  inside
  done
  finished

  @@map("site_visit_status")
}

/// Satu kali unit berada di radius front loading / dumping rutenya. departAt null = masih di dalam.
model SiteVisit {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String?         @map("assignment_id") @db.Uuid
  shiftId      String?         @map("shift_id") @db.Uuid
  driverId     String?         @map("driver_id") @db.Uuid
  imei         String
  routeId      String?         @map("route_id") @db.Uuid
  siteId       String          @map("site_id") @db.Uuid
  siteName     String          @map("site_name")
  role         SiteVisitRole
  arriveAt     DateTime        @map("arrive_at") @db.Timestamptz(3)
  departAt     DateTime?       @map("depart_at") @db.Timestamptz(3)
  dwellMs      BigInt          @map("dwell_ms")
  /// Pecahan dwell: antre (zona queue / diam sebelum inti), spot (zona spot), sisanya di radius inti.
  queueMs      BigInt?         @map("queue_ms")
  spotMs       BigInt?         @map("spot_ms")
  workMs       BigInt?         @map("work_ms")
  status       SiteVisitStatus
  computedAt   DateTime        @default(now()) @map("computed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  assignment   Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  shift        Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  driver       User?           @relation(fields: [driverId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  device       Device          @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)
  route        Route?          @relation(fields: [routeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  site         Site            @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([imei, siteId, arriveAt], map: "site_visits_imei_site_arrive")
  @@index([arriveAt], map: "site_visits_arrive_at")
  @@index([shiftId], map: "site_visits_shift_id")
  @@index([assignmentId], map: "site_visits_assignment_id")
  @@map("site_visits")
}

// ---------- Zona antre / spot ----------

enum SiteZoneKind {
  queue
  spot

  @@map("site_zone_kind")
}

/// Sub-geofence lingkaran di dalam/sekitar titik: zona antre dan zona spot (posisi muat/bongkar).
model SiteZone {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String       @map("site_id") @db.Uuid
  kind      SiteZoneKind
  lat       Float
  lng       Float
  radiusM   Int          @default(20) @map("radius_m")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid
  deletedBy String?      @map("deleted_by") @db.Uuid
  site      Site         @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([siteId], map: "site_zones_site_id")
  @@map("site_zones")
}

// ---------- Target produksi ----------

/// Target per rute, berlaku mulai validFrom sampai ada target baru.
model ProductionTarget {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId     String    @map("route_id") @db.Uuid
  ritPerHour  Float?    @map("rit_per_hour")
  tonPerHour  Float?    @map("ton_per_hour")
  ritPerShift Float?    @map("rit_per_shift")
  tonPerShift Float?    @map("ton_per_shift")
  validFrom   DateTime  @default(dbgenerated("CURRENT_DATE")) @map("valid_from") @db.Date
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([routeId, validFrom], map: "production_targets_route_valid")
  @@map("production_targets")
}

// ---------- Status unit & MDT ----------

enum UnitStatus {
  working
  standby
  breakdown

  @@map("unit_status")
}

enum DelayCategory {
  working
  standby_planned
  standby_unplanned
  breakdown

  @@map("delay_category")
}

enum UnitStatusSource {
  auto
  supervisor
  dmr
  mdt

  @@map("unit_status_source")
}

/// Master delay code (P2H, Ishoma, Sholat, Antre, BD, ...).
model DelayCode {
  code      String          @id @db.VarChar(20)
  name      String          @db.VarChar(100)
  category  DelayCategory
  icon      String?         @db.VarChar(40)
  sort      Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy String?         @map("created_by") @db.Uuid
  updatedBy String?         @map("updated_by") @db.Uuid
  logs      UnitStatusLog[]

  @@map("delay_codes")
}

/// Log status unit. endAt null = status yang sedang berlaku. id dari MDT (uuid) agar kiriman ulang tidak tercatat ganda.
model UnitStatusLog {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imei         String
  driverId     String?          @map("driver_id") @db.Uuid
  assignmentId String?          @map("assignment_id") @db.Uuid
  status       UnitStatus
  delayCode    String?          @map("delay_code") @db.VarChar(20)
  startAt      DateTime         @map("start_at") @db.Timestamptz(3)
  endAt        DateTime?        @map("end_at") @db.Timestamptz(3)
  source       UnitStatusSource
  note         String?
  clientAt     DateTime?        @map("client_at") @db.Timestamptz(3)
  receivedAt   DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  createdBy    String?          @map("created_by") @db.Uuid
  device       Device           @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)
  driver       User?            @relation(fields: [driverId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignment   Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  delay        DelayCode?       @relation(fields: [delayCode], references: [code], onDelete: SetNull, onUpdate: Cascade)

  @@index([imei, startAt], map: "unit_status_logs_imei_start")
  @@index([startAt], map: "unit_status_logs_start_at")
  @@map("unit_status_logs")
}

/// Tablet MDT di kabin, dipasangkan ke satu unit lewat kode pairing.
model MdtTablet {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imei            String
  name            String?   @db.VarChar(100)
  tokenHash       String?   @unique(map: "mdt_tablets_token_hash_key") @map("token_hash") @db.VarChar(64)
  pairCodeHash    String?   @map("pair_code_hash") @db.VarChar(64)
  pairCodeExpires DateTime? @map("pair_code_expires") @db.Timestamptz(3)
  pairedAt        DateTime? @map("paired_at") @db.Timestamptz(3)
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  device          Device    @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([imei], map: "mdt_tablets_imei")
  @@map("mdt_tablets")
}

// ---------- Data jalan ----------

/// Jalur jalan yang sudah dihitung (from → to). coords = [[lat, lng], ...].
model RoadPath {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique @db.VarChar(32)
  fromLat    Float    @map("from_lat")
  fromLng    Float    @map("from_lng")
  toLat      Float    @map("to_lat")
  toLng      Float    @map("to_lng")
  coords     Json
  pointCount Int      @map("point_count")
  distanceM  Float    @map("distance_m")
  durationS  Float    @map("duration_s")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  @@index([createdAt], map: "road_paths_created_at")
  @@map("road_paths")
}

/// Data jalan OSM (Overpass) per kotak area, disimpan seminggu.
model RoadArea {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique @db.VarChar(120)
  kind         String   @db.VarChar(10)
  south        Float
  west         Float
  north        Float
  east         Float
  elements     Json
  elementCount Int      @map("element_count")
  sizeBytes    Int      @map("size_bytes")
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@map("road_areas")
}

/// Cadangan tabel drivers sebelum operator dilebur ke users (20261020000000_operators_as_users).
/// Tidak dipakai kode; dihapus di migrasi berikutnya setelah diperiksa.
model DriverLegacy {
  id         String    @id(map: "drivers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  phone      String?
  employeeNo String?   @map("employee_no")
  ibutton    String?
  pinHash    String?   @map("pin_hash")
  active     Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedBy  String?   @map("deleted_by") @db.Uuid

  @@map("drivers_legacy")
}
